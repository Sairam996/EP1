# Copy to backend/.env — never commit the real file.
MONGO_URL=mongodb://user:pass@127.0.0.1:27017/?authSource=admin
DB_NAME=thara
JWT_SECRET_KEY=change-me-long-random-string
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes (no refresh tokens yet — users re-login on expiry). Max recommended 1440.
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Required for KYC submit. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KYC_ENCRYPTION_KEY=
ADMIN_SECRET=change-me
# Comma-separated allowed browser origins (no "*").
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Demo vendors with known passwords — local dev ONLY. Keep false in production.
ENABLE_DEMO_SEED=false
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
BACKEND_URL=http://127.0.0.1:8000
